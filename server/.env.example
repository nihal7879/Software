# Copy this file to `.env` and fill in the blanks. `.env` is never committed.
#
# The values left filled in below are not secrets — they are the settings the
# app expects. Everything blank is a secret or a machine-specific address, and
# has to come from whoever runs the institute's server.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ---------------------------------------------------------------
# Keep one set per environment and uncomment exactly ONE.
#
# If both are left live, dotenv keeps the LAST one it reads, silently — so put
# production ABOVE development. Forget to comment one out and you stay on dev,
# which is the harmless way round to get it wrong.
#
# After changing this, RESTART the server: the values are read once at startup.

# --- PRODUCTION ------------------------------------------ currently OFF ---
#DB_HOST=
#DB_PORT=3306
#DB_USER=
#DB_PASSWORD=
#DB_NAME=classroom_app

# --- DEVELOPMENT ----------------------------------------- currently ON ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=classroom_app

# Any long random string. Changing it signs everybody out.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ---- Email (SMTP) ----------------------------------------------------------
# While these are blank nothing is actually sent: each message is recorded in
# the email_log table as "not sent — email not set up". That is intended, so
# the app runs fine without a mail account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Who is told when a student registers.
ADMIN_NOTIFY_EMAIL=
# The link used in emails ("sign in at …").
APP_URL=http://localhost:5173

# ---- Speech to text (AssemblyAI) -------------------------------------------
# Blank means the Speak button reports that it is not set up rather than
# failing. See claude/08-features.txt.
ASSEMBLYAI_API_KEY=

# ---- The institute's clock -------------------------------------------------
# Everything runs on Dubai time. Vercel reserves the name TZ and will not let
# you set it there, which is why config.ts sets it in code as well.
TZ=Asia/Dubai

# ---- Web push notifications -------------------------------------------------
# One pair, generated once with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public half is handed to each browser when it subscribes; the private half
# signs what we send. Replacing them silently stops every notification anyone
# has already allowed, so generate once and leave them alone.
# Blank means notifications are off: the button says "not set up" and nothing fails.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the browser's push service can use if our notifications cause trouble.
VAPID_SUBJECT=mailto:contact@stemvision.ae

# A student's sign-in lasts longer than everybody else's: the app is mostly a QR
# scanner to them, and a password prompt at the classroom door loses the scan.
# They see only their own attendance. See server/src/config.ts.
JWT_EXPIRES_IN_STUDENT=15d
